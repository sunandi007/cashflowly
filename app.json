{
  "expo": {
    "name": "CashFlowly",
    "slug": "CashFlowly",
    "scheme": "cashflowly",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon-cashflowly.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon-cashflowly.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A2E26"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-cashflowly.png",
        "backgroundColor": "#1A2E26"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.sunandi.CashFlowly",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "ehlascpnadaraaltoopa.supabase.co",
              "pathPrefix": "/auth/v1/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "945b83f5-f442-4d5c-8260-689243aa1c3e"
      }
    },
    "owner": "sunandi",
    "plugins": [
      "expo-web-browser"
    ]
  }
}